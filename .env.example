# The show's podcast RSS feed (from Libsyn), used to list episodes live.
# Find it in Libsyn under Destinations, or reuse the feed URL submitted to Apple Podcasts.
PODCAST_RSS_URL=https://your-show.libsyn.com/rss

# YouTube Data API v3 key, used to match episodes to their YouTube upload by
# episode number. Create one at https://console.cloud.google.com/ (APIs &
# Services > Credentials), restricted to the YouTube Data API v3.
YOUTUBE_API_KEY=
